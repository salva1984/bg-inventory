# Copy to .env and adjust. Never commit .env.
# Docker Compose uses Development unless API_ENVIRONMENT is set to another environment.
API_ENVIRONMENT=Development

# Host ports for SQL Server, the telemetry dashboard (UI and OTLP receiver), and the API.
DB_PORT=1433
# SQL Server password must be at least 8 chars, with uppercase, lowercase, digit, and symbol.
DB_PASSWORD=Dev_Passw0rd!

DASHBOARD_UI_PORT=18888
OTLP_PORT=4317
API_PORT=8080


JWT_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Initial user passwords, whether to create sample inventory data and how many
# extra products to generate on top of it (0 = only the fixed challenge data).
SEED_ADMIN_PASSWORD=Admin123!
SEED_VIEWER_PASSWORD=Viewer123!
SEED_SAMPLE_DATA=true
SEED_SAMPLE_PRODUCT_COUNT=200

# OpenRouter key for the invoice analysis (model and endpoint in appsettings.json, section
# InvoiceExtraction). Empty: the API still runs and only POST /api/invoices/analyze answers 503.
OPENROUTER_API_KEY=""

# Frontend origin allowed to call the API from a browser (local). The production origin
# (Azure App Service) is the default in backend/src/BgInventario.Api/appsettings.json.
CORS_ORIGIN=http://localhost:4200

# Compose enables database migrations and Swagger independently of API_ENVIRONMENT.
