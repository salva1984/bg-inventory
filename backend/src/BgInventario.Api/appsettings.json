{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "bginventario-api",
    "Audience": "bginventario-web",
    "Key": "",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://front-angular-ewh7gydndudycjdv.westus3-01.azurewebsites.net" ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "AdminEmail": "admin@inventario.local",
    "ViewerEmail": "viewer@inventario.local",
    "SampleData": false,
    "SampleProductCount": 0
  },
  "InvoiceExtraction": {
    "Endpoint": "https://openrouter.ai/api/v1",
    "Model": "openai/gpt-6-luna",
    "ApiKey": "",
    "ReasoningEffort": "Medium"
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
